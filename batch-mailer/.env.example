# ─── Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# NOTE: VITE_* variables are embedded in the frontend bundle.
# The AI API key is now server-side only (read by server/server.js)
# and never reaches the client.

# Gmail OAuth Client ID (from Google Cloud Console)
# This is public by design — it's registered in Google Cloud Console
VITE_GMAIL_CLIENT_ID=

# AI Provider (OpenRouter-compatible API)
# The API key is read by the backend proxy server (server/server.js) only.
# The model name is read by the frontend (not sensitive — it's just a model ID).
VITE_AI_BASE_URL=https://openrouter.ai/api/v1
VITE_AI_API_KEY=
VITE_AI_VISION_MODEL=openai/gpt-4o-mini
VITE_AI_REASONING_MODEL=openai/gpt-4o